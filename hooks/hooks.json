{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/reset.js\"; exit 0",
            "timeout": 5,
            "statusMessage": "airblander: resetting session state..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/resolve.js\"; exit 0",
            "timeout": 10,
            "statusMessage": "airblander: scanning prompt for SDK intent..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/detect.js\"",
            "timeout": 10,
            "statusMessage": "airblander: checking SDK imports..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|mcp__context7__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/clear.js\"; exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
