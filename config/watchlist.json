{
  "sdks": [
    {
      "name": "twilio",
      "keywords": [
        "twilio",
        "twilio.rest",
        "twilio sms",
        "twilio voice",
        "twilio video"
      ],
      "patterns": [
        "import\\s+[\"']?twilio",
        "from\\s+[\"']?twilio",
        "require\\s*\\([\"']twilio"
      ],
      "docsUrl": "https://www.twilio.com/docs",
      "docsDomains": [
        "twilio\\.com",
        "\\/twilio\\/",
        "twilio"
      ],
      "context7Query": "twilio",
      "deprecated": [
        {
          "pattern": "Twilio\\.RestClient\\(",
          "replacement": "twilio(accountSid, authToken)",
          "reason": "RestClient removed in twilio-node v4, use the default export function"
        },
        {
          "pattern": "client\\.messages\\.create\\([^)]*from:",
          "replacement": "messagingServiceSid or use E.164 from number",
          "reason": "Hardcoded 'from' without E.164 format deprecated; prefer MessagingService SID"
        }
      ]
    },
    {
      "name": "pipecat",
      "keywords": [
        "pipecat",
        "pipecat-ai",
        "pipecat pipeline",
        "pipecat agent"
      ],
      "patterns": [
        "import\\s+[\"']?pipecat",
        "from\\s+[\"']?pipecat",
        "require\\s*\\([\"']pipecat"
      ],
      "docsUrl": "https://docs.pipecat.ai",
      "docsDomains": [
        "pipecat\\.ai",
        "\\/pipecat\\/",
        "pipecat"
      ],
      "context7Query": "pipecat",
      "deprecated": []
    },
    {
      "name": "livekit",
      "keywords": [
        "livekit",
        "livekit-agents",
        "livekit agent",
        "livekit room",
        "livekit sip"
      ],
      "patterns": [
        "import\\s+[\"']?livekit",
        "from\\s+[\"']?livekit",
        "require\\s*\\([\"']livekit"
      ],
      "docsUrl": "https://docs.livekit.io",
      "docsDomains": [
        "livekit\\.io",
        "\\/livekit\\/",
        "livekit"
      ],
      "context7Query": "livekit",
      "deprecated": [
        {
          "pattern": "RoomServiceClient\\(",
          "replacement": "RoomServiceClient from @livekit/protocol or livekit-server-sdk",
          "reason": "Direct RoomServiceClient instantiation API changed in livekit-server-sdk v2"
        }
      ]
    },
    {
      "name": "google-genai",
      "keywords": [
        "gemini",
        "google genai",
        "google generative ai",
        "gemini live",
        "gemini api",
        "gemini flash",
        "gemini pro",
        "@google/generative-ai",
        "google.generativeai",
        "generative-ai"
      ],
      "patterns": [
        "import\\s+[\"']?@google/generative-ai",
        "from\\s+[\"']?@google/generative-ai",
        "require\\s*\\([\"']@google/generative-ai",
        "import\\s+google\\.generativeai",
        "from\\s+google\\.generativeai"
      ],
      "docsUrl": "https://ai.google.dev/api/live",
      "docsDomains": [
        "ai\\.google\\.dev",
        "generativeai\\.google\\.com",
        "generative-ai",
        "google.*generativeai",
        "generativeai"
      ],
      "context7Query": "google generative-ai",
      "deprecated": [
        {
          "pattern": "chat-bison",
          "replacement": "gemini-2.0-flash",
          "reason": "PaLM 2 chat-bison model retired, migrate to Gemini"
        },
        {
          "pattern": "text-bison",
          "replacement": "gemini-2.0-flash",
          "reason": "PaLM 2 text-bison model retired, migrate to Gemini"
        },
        {
          "pattern": "gemini-pro(?!-vision|-1\\.5|-2)",
          "replacement": "gemini-2.0-flash or gemini-1.5-pro",
          "reason": "gemini-pro (1.0) deprecated, use a versioned model ID"
        },
        {
          "pattern": "\\.generateText\\(",
          "replacement": "model.generateContent()",
          "reason": "generateText removed from @google/generative-ai v0.2+"
        }
      ]
    },
    {
      "name": "aws-bedrock",
      "keywords": [
        "aws bedrock",
        "amazon bedrock",
        "bedrock",
        "bedrock api",
        "invoke model",
        "bedrock runtime",
        "converse api"
      ],
      "patterns": [
        "import\\s+boto3",
        "from\\s+boto3",
        "require\\s*\\([\"']@aws-sdk/client-bedrock",
        "import\\s+[\"']?@aws-sdk/client-bedrock",
        "from\\s+[\"']?@aws-sdk/client-bedrock",
        "bedrock-runtime",
        "BedrockRuntime"
      ],
      "docsUrl": "https://docs.aws.amazon.com/bedrock/latest/APIReference/",
      "docsDomains": [
        "docs\\.aws\\.amazon\\.com.*bedrock",
        "aws\\.amazon\\.com.*bedrock",
        "\\/bedrock\\/",
        "bedrock"
      ],
      "context7Query": "aws-sdk-js-v3 bedrock",
      "deprecated": [
        {
          "pattern": "anthropic\\.claude-v2",
          "replacement": "anthropic.claude-sonnet-4-5-v1:0 or newer",
          "reason": "claude-v2 model ID retired on AWS Bedrock"
        },
        {
          "pattern": "anthropic\\.claude-instant",
          "replacement": "anthropic.claude-haiku-4-5-v1:0",
          "reason": "claude-instant models retired on AWS Bedrock"
        },
        {
          "pattern": "amazon\\.titan-text-express",
          "replacement": "Check AWS docs — Titan models have varied retirement dates",
          "reason": "Amazon Titan text models being phased out"
        },
        {
          "pattern": "invoke_model\\(",
          "replacement": "converse() or invoke_model() with current model IDs",
          "reason": "InvokeModel still works but Converse API is the preferred interface for chat models"
        }
      ]
    },
    {
      "name": "anthropic",
      "keywords": [
        "claude",
        "claude api",
        "anthropic",
        "anthropic sdk",
        "claude sonnet",
        "claude opus",
        "claude haiku",
        "claude 3",
        "claude 4",
        "claude model"
      ],
      "patterns": [
        "import\\s+anthropic",
        "from\\s+anthropic",
        "require\\s*\\([\"']anthropic",
        "import\\s+[\"']?@anthropic-ai",
        "from\\s+[\"']?@anthropic-ai",
        "require\\s*\\([\"']@anthropic-ai"
      ],
      "docsUrl": "https://docs.anthropic.com/en/api/",
      "docsDomains": [
        "docs\\.anthropic\\.com",
        "\\/anthropic\\/",
        "anthropic"
      ],
      "context7Query": "anthropic",
      "deprecated": [
        {
          "pattern": "\\.completions\\.create\\(",
          "replacement": "client.messages.create()",
          "reason": "Text Completions API deprecated; Messages API is the current standard"
        },
        {
          "pattern": "claude-instant-",
          "replacement": "claude-haiku-4-5",
          "reason": "claude-instant models retired Jan 2025"
        },
        {
          "pattern": "\"claude-2",
          "replacement": "claude-sonnet-4-6 or claude-opus-4-8",
          "reason": "claude-2 family retired"
        },
        {
          "pattern": "'claude-2",
          "replacement": "claude-sonnet-4-6 or claude-opus-4-8",
          "reason": "claude-2 family retired"
        },
        {
          "pattern": "claude-v1",
          "replacement": "current claude-* model ID",
          "reason": "claude-v1 model family removed"
        },
        {
          "pattern": "claude-3-opus-20240229",
          "replacement": "claude-opus-4-8",
          "reason": "Dated snapshot ID; use the latest Opus model ID"
        },
        {
          "pattern": "claude-3-5-sonnet-20240620",
          "replacement": "claude-sonnet-4-6",
          "reason": "Dated snapshot ID; use the latest Sonnet model ID"
        }
      ]
    },
    {
      "name": "azure-communication",
      "keywords": [
        "azure communication",
        "azure communication services",
        "acs sms",
        "acs calling",
        "azure sms",
        "@azure/communication"
      ],
      "patterns": [
        "import\\s+[\"']?@azure/communication",
        "from\\s+[\"']?@azure/communication",
        "require\\s*\\([\"']@azure/communication",
        "from\\s+azure\\.communication",
        "import\\s+azure\\.communication"
      ],
      "docsUrl": "https://learn.microsoft.com/en-us/azure/communication-services",
      "docsDomains": [
        "learn\\.microsoft\\.com.*communication",
        "azure.*communication",
        "communication-services"
      ],
      "context7Query": "azure communication services",
      "deprecated": [
        {
          "pattern": "@azure/communication-sms",
          "replacement": "@azure/communication-messages for WhatsApp/advanced, or keep for basic SMS",
          "reason": "@azure/communication-sms is stable but @azure/communication-messages is the modern path for multi-channel"
        }
      ]
    },
    {
      "name": "stripe",
      "keywords": [
        "stripe",
        "stripe api",
        "stripe sdk"
      ],
      "patterns": [
        "import\\s+[\"']?stripe",
        "from\\s+[\"']?stripe",
        "require\\s*\\([\"']stripe"
      ],
      "docsUrl": "https://stripe.com/docs",
      "docsDomains": [
        "stripe\\.com",
        "\\/stripe\\/",
        "stripe"
      ],
      "context7Query": "stripe",
      "deprecated": [
        {
          "pattern": "stripe\\.charges\\.create",
          "replacement": "stripe.paymentIntents.create",
          "reason": "Charges API works but PaymentIntents is the modern standard; required for 3DS/SCA"
        },
        {
          "pattern": "stripe\\.sources\\.create",
          "replacement": "stripe.paymentMethods.create",
          "reason": "Sources API deprecated in favour of PaymentMethods"
        },
        {
          "pattern": "stripe\\.orders\\.create",
          "replacement": "Use PaymentIntents + custom fulfillment logic",
          "reason": "Orders API v1 retired"
        }
      ]
    },
    {
      "name": "openai",
      "keywords": [
        "openai",
        "openai api",
        "openai sdk"
      ],
      "patterns": [
        "import\\s+[\"']?openai",
        "from\\s+[\"']?openai",
        "require\\s*\\([\"']openai"
      ],
      "docsUrl": "https://platform.openai.com/docs",
      "docsDomains": [
        "platform\\.openai\\.com",
        "\\/openai\\/",
        "openai"
      ],
      "context7Query": "openai",
      "deprecated": [
        {
          "pattern": "openai\\.Completion\\.create",
          "replacement": "client.completions.create()",
          "reason": "Pre-v1.0 class-based API removed in openai-python v1.0"
        },
        {
          "pattern": "openai\\.ChatCompletion\\.create",
          "replacement": "client.chat.completions.create()",
          "reason": "Pre-v1.0 class-based API removed in openai-python v1.0"
        },
        {
          "pattern": "gpt-3\\.5-turbo-0301",
          "replacement": "gpt-4o-mini",
          "reason": "Dated snapshot model ID retired"
        },
        {
          "pattern": "text-davinci-003",
          "replacement": "gpt-4o or gpt-4o-mini",
          "reason": "Legacy completion models retired Jan 2024"
        },
        {
          "pattern": "openai\\.api_key\\s*=",
          "replacement": "OpenAI(api_key=os.environ['OPENAI_API_KEY'])",
          "reason": "Module-level api_key assignment removed in openai-python v1.0; pass via client constructor"
        }
      ]
    }
  ]
}
